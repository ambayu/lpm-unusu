# ==========================================
# LPM UNUSU - Unified Environment
# ==========================================

PORT=5004
DATABASE_URL="mysql://root:@localhost:3306/lpm_unusu_db"
CORS_ORIGIN="http://localhost:5177"
VITE_API_URL="/api"

# --- Secret sesi JWT (WAJIB; server menolak start bila kosong) ---
# Buat dengan: openssl rand -hex 32
JWT_SECRET="<generate-with-openssl-rand-hex-32>"

# --- SSO ONE UNUSU ---
SSO_BASE_URL="http://localhost:5000"
SSO_CLIENT_ID="<clientId-dari-one-unusu>"
# Rahasia server-ke-server. Jangan pernah masuk repo.
SSO_CLIENT_KEY="<client-key-dari-one-unusu>"
VITE_ONE_UNUSU_URL="http://localhost:5173"
