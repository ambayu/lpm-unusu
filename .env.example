# ==========================================
# LPM UNUSU - Unified Environment
# ==========================================

PORT=5004
DATABASE_URL="mysql://root:@localhost:3306/lpm_unusu_db"
CORS_ORIGIN="http://localhost:5177"
VITE_API_URL="/api"

# --- Secret sesi JWT (WAJIB; server menolak start bila kosong) ---
# Buat dengan: openssl rand -hex 32
JWT_SECRET="<generate-with-openssl-rand-hex-32>"

# --- SSO ONE UNUSU ---
SSO_BASE_URL="http://localhost:5000/sso"
SSO_CLIENT_ID="014813db6bffb39f"
# Rahasia server-ke-server. Jangan pernah masuk repo.
SSO_CLIENT_KEY="<client-key-dari-one-unusu>"
VITE_ONE_UNUSU_URL="http://localhost:5183"
VITE_SSO_CLIENT_ID="014813db6bffb39f"

# --- Token layanan arsip dokumen ---
# Dipakai bersama oleh ONE UNUSU, LPM, dan LPPM dengan nilai yang SAMA.
# Portal menerbitkan token baca-saja (arsip.<clientId>.<hmac>) yang hanya
# memberi izin membaca arsip dokumen, tidak pernah menulis.
ARSIP_SERVICE_TOKEN_SECRET="<secret-acak-hex-64>"
# --- Berkas arsip dokumen PDF ---
# PDF disimpan sebagai berkas di uploads/dokumen, dan kolom filePdfUrl hanya
# berisi URL bertanda tangan (tidak pernah base64). Secret ini WAJIB sama di
# LPM dan LPPM agar URL yang diterbitkan satu aplikasi dapat dibaca aplikasi lain.
ARSIP_FILE_URL_SECRET="ed4459df76cf6be0f017a5e3af430d86f82a8b4f35bf4c8981736a24d26c3381"
# Base URL publik tempat berkas arsip disajikan (dipakai saat menyusun URL).
ARSIP_PUBLIC_BASE_URL="http://localhost:5004"
